# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# OIDC / Keycloak SSO
# Replace the URLs below with your OpenID Connect discovery document and callback URL.
# Example provider URL:
# OPENID_PROVIDER_URL='https://keycloak.example.com/realms/<realm>/.well-known/openid-configuration'
# Example redirect URL:
# OPENID_REDIRECT_URI='https://open-webui.example.com/oauth/oidc/callback'
ENABLE_OAUTH_SIGNUP='true'
OAUTH_MERGE_ACCOUNTS_BY_EMAIL='false'
OAUTH_PROVIDER_NAME='Keycloak'
OAUTH_CLIENT_ID=''
OAUTH_CLIENT_SECRET=''
OPENID_PROVIDER_URL=''
OPENID_REDIRECT_URI=''
OPENID_END_SESSION_ENDPOINT=''
OAUTH_SCOPES='openid email profile'
OAUTH_CODE_CHALLENGE_METHOD=''
OAUTH_TOKEN_ENDPOINT_AUTH_METHOD='client_secret_post'
OAUTH_ALLOWED_DOMAINS='*'
OAUTH_USERNAME_CLAIM='preferred_username'
OAUTH_EMAIL_CLAIM='email'
OAUTH_PICTURE_CLAIM='picture'
OAUTH_ROLES_CLAIM='realm_access.roles'
OAUTH_ALLOWED_ROLES='user,admin'
OAUTH_ADMIN_ROLES='admin'
ENABLE_OAUTH_ROLE_MANAGEMENT='false'
OAUTH_GROUPS_CLAIM='groups'
ENABLE_OAUTH_GROUP_MANAGEMENT='false'
ENABLE_OAUTH_GROUP_CREATION='false'
ENABLE_OAUTH_BACKCHANNEL_LOGOUT='false'
OAUTH_AUTHORIZE_PARAMS=''

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false